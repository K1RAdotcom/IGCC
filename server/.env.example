# PostgreSQL connection string
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

# Long random secret used to sign session cookies
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Frontend origin allowed by CORS (not needed when the API and frontend share one address, e.g. on Vercel)
CORS_ORIGIN=https://your-frontend-domain.example

# Use production in deployment
NODE_ENV=production

# Password-reset emails (Resend)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM=IGCC <no-reply@your-verified-domain.example>

# Public address of the app, used in password-reset links.
# On Vercel this falls back to the project production URL if unset.
APP_URL=https://your-app.vercel.app

# Optional:
# Leave unset unless the backend is behind a trusted reverse proxy.
# Example for one proxy:
# TRUST_PROXY=1